# Server
APP_PORT=8080

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5433
POSTGRES_EXTERNAL_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=diagram_db
DB_SSLMODE=disable

# Redis & Background Queue
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
AI_PROVIDER=openai

# Meta Model API through the OpenAI-compatible client.
# Keep other key aliases empty when using MODEL_API_KEY.
OPEN_AI_BASE_URL=https://api.meta.ai/v1
OPEN_AI_MODEL=muse-spark-1.3
MODEL_API_KEY=
# Optional key alias for other OpenAI-compatible providers:
OPEN_AI_API_KEY=

# Output token budget per UI-screen. A single production-ready screen fits in ~3-5k;
# a large cap invites over-generation (latency, cost, unrequested UI bloat).
AI_MAX_TOKENS=10000

# Internal Service Auth (Go <-> Python CrewAI)
INTERNAL_SERVICE_KEY=
ORCHESTRATION_SERVICE_URL=http://localhost:8000

# First boot only: generate a random 32-64 byte key (openssl rand -hex 32).
# Existing admin credentials are never overwritten by this value.
MASTER_ADMIN_KEY=

# Local HTTP only: set true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
AUTH_LEGACY_CREDENTIALS=false

# Required only when AI_PROVIDER=anthropic (Go backend).
ANTHROPIC_API_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
