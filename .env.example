# Server
APP_PORT=8080

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5433
POSTGRES_EXTERNAL_PORT=5433
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=diagram_db
DB_SSLMODE=disable

# Redis & Background Queue
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
AI_PROVIDER=openai

# OpenAI / Compatible Router (9router / OpenRouter / v1)
OPEN_AI_BASE_URL=https://9router.bby-dev.tech/v1
OPEN_AI_API_KEY=your_openai_or_router_key_here
OPEN_AI_MODEL=cx/gpt-5.6-sol

# Internal Service Auth (Go <-> Python CrewAI)
INTERNAL_SERVICE_KEY=secret-internal-key-project-diagram
ORCHESTRATION_SERVICE_URL=http://localhost:8000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
